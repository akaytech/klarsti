rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Burada bilerek "hepsini kapat" bloğu YOK.
    // Firestore kurallarında yalnızca izin verme (allow) vardır, yasaklama yoktur:
    // bir istek, eşleşen kurallardan HERHANGİ BİRİ izin verirse geçer. Hiçbiri
    // eşleşmezse zaten reddedilir. Bu yüzden eskiden burada duran
    //     match /{document=**} { allow read, write: if false; }
    // bloğu hiçbir şey yapmıyordu; ne erişim veriyordu ne de aşağıdaki kuralları
    // sınırlıyordu. "Varsayılan erişimi kapattık" diyen yorumu yüzünden emniyet
    // kemeri sanılabilirdi, oysa değildi. Tekrar eklemeyin: koruma sağlamaz,
    // yalnızca yanlış güven verir. Asıl koruma, aşağıdaki kuralların kendisidir.

    // Yönetim ekranını (klarsti.com/admin) besleyen tek istisna.
    //
    // Neden gerekiyor: aşağıdaki kuralların hepsi "yalnızca sahibi" diyor,
    // bu doğru. Ama o zaman kaç kullanıcı var, hangi araç kullanılıyor,
    // birinin kaç çalışması var gibi soruların uygulama içinde cevabı yok.
    // Firebase konsolu yalnızca kayıt listesini gösteriyor, kullanımı değil.
    //
    // YALNIZCA OKUMA. Yazma, güncelleme, silme dallarına bilerek eklenmedi:
    // ekranın yazacak hiçbir şeyi yok ve bir gün kod hata yapsa bile bu
    // hesap kimsenin verisini bozamaz.
    //
    // Numara admin@klarsti.com hesabına ait; sahibinin günlük kullandığı
    // kişisel hesap değil. Ayrı tutuluyor ki yönetim erişimi, her gün her
    // yerde kullanılan ve oltalama maili alan hesaba bağlı kalmasın.
    //
    // Riski açık olsun: bu hesabın ele geçirilmesi bütün kullanıcı verisinin
    // okunması demek. Karşılığı kabul edildi; azaltmak için hesapta iki
    // adımlı doğrulama açık olmalı.
    //
    // DİKKAT: Numara src/config/yonetici.ts içinde de yazılı, ikisi aynı
    // kalmalı. Kurallarda değişken tanımlanamıyor, bu yüzden kopya.
    function yonetici() {
      return request.auth != null
             && request.auth.uid == 'nAyfA6WDEUfG0i5duXsVBgBeJbA3';
    }

    // Kimlik satırı: ad, e-posta, ilk ve son görülme. Başka hiçbir şey.
    //
    // Neden users/{uid} içinde değil: orası ajandanın kendisini taşıyor.
    // Yöneticiye o kaydı açsaydık insanların notlarını okuyabilir hale
    // gelirdi. Ayrı koleksiyon sayesinde ajanda ve gün sonu değerlendirmesi
    // yönetim ekranının erişemeyeceği yerde kalıyor.
    //
    // Yazmayı yalnızca kişinin kendisi yapabiliyor: başkasının satırını
    // yazabilmek, o kişi adına kayıt uydurmak olurdu.
    match /profiles/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId || yonetici());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Kişisel veriler (ajanda, ileride gün sonu değerlendirmesi).
    // Proje paylaşımından tamamen bağımsızdır: bir kullanıcının kişisel verisini
    // yalnızca kendisi okuyabilir ve yazabilir, paylaşılan proje linki buraya erişemez.
    //
    // Yönetici burada BİLEREK yok: bu kayıtlar insanların yazdığı metin.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Alt koleksiyonlar da aynı kurala tabidir (kurallar kendiliğinden inmez).
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Blog yazıları: klarsti.com/blog
    //
    // Burası kullanıcı verisi değil, sitenin kendi içeriği. Bu yüzden diğer
    // koleksiyonların "yalnızca sahibi" kuralı geçerli değil: okuma herkese
    // açık, yazma yalnızca yöneticide.
    //
    // Okumada `durum` şartı var: taslaklar dışarı çıkmamalı. Yarım bir yazının
    // adresini tahmin eden birine açılırsa, yayınlanmamış metin yayınlanmış
    // olur. Yönetici kendi taslaklarını görebiliyor.
    //
    // DİKKAT: Liste sorgusu da bu kurala uymak zorunda, yani yazıları çeken
    // sorgu `where('durum','==','yayinda')` içermeli; içermezse Firestore
    // sorgunun tamamını reddeder (tek tek belgeleri elemez).
    match /blog/{slug} {
      allow read: if resource.data.durum == 'yayinda' || yonetici();
      allow write: if yonetici();
    }

    // Sadece 'projects' koleksiyonuna belirli kurallarla erişime izin ver.
    match /projects/{projectId} {

      // Katılanlar listesi (members): UID -> { name, email, joinedAt }.
      // Sahip dışındaki herkes bu haritada YALNIZCA kendi anahtarına
      // dokunabilir. Liste sahibin "kim katılmış" ekranını beslediği için,
      // başkasının satırını yazabilmek kimliğe bürünmek demek olurdu.
      // members hiç yoksa iki taraf da boş harita sayılır ve fark çıkmaz.
      function kendiSatiri() {
        return request.resource.data.get('members', {})
                 .diff(resource.data.get('members', {}))
                 .affectedKeys()
                 .hasOnly([request.auth.uid]);
      }

      // CREATE: Sadece giriş yapmış kullanıcılar proje oluşturabilir
      // VE oluşturan kişi kendini 'userId' olarak ayarlamak zorundadır.
      //
      // Yeni proje BOŞ bir paylaşım listesiyle doğmak zorunda. Eskiden bu alana
      // bakılmıyordu: isteyen, içine başkasının UID'sini yazdığı bir proje
      // oluşturabiliyordu. Proje listesi "sharedWith içinde benim UID'm var mı"
      // sorgusuyla çekildiği için o proje, hiç haberi olmayan kullanıcının
      // ekranında beliriyordu. Reklam ya da oltalama için hazır bir kapıydı.
      // Paylaşım artık yalnızca sonradan, sahibin bilerek açtığı linkle oluyor.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.get('sharedWith', []).size() == 0
                    && request.resource.data.get('members', {}).keys().size() == 0;
      
      // READ: Sadece giriş yapmış kullanıcılar okuyabilir 
      // VE (Projenin sahibi ise VEYA projenin 'sharedWith' dizisinde var ise).
      // NOT: joinSharedProject fonksiyonu, kullanıcı sharedWith dizisinde olmasa bile
      // isPublic=true olan projeyi okumaya çalışır (getDoc). Bu nedenle isPublic kuralı eklendi.
      // yonetici(): klasör sayısı ve "kimin kaç klasörü var" için gerekiyor.
      // Yalnızca okuma; yönetim ekranı hiçbir klasöre yazamaz.
      allow read: if request.auth != null
                  && (
                    resource.data.get('userId', '') == request.auth.uid ||
                    request.auth.uid in resource.data.get('sharedWith', []) ||
                    resource.data.get('isPublic', false) == true ||
                    yonetici()
                  );
      
      // UPDATE: Üç ayrı yetki seviyesi var.
      //
      // Sahiplik alanı (userId) hiçbir durumda değiştirilemez; bu, sahiplik
      // çalınmasını (Ownership Stealing) veritabanı seviyesinde yasaklar.
      allow update: if request.auth != null
                    && request.resource.data.get('userId', '') == resource.data.get('userId', '')
                    && (
                      // 1) Sahip: projenin her alanını değiştirebilir.
                      resource.data.get('userId', '') == request.auth.uid
                      ||
                      // 2) Ortak çalışan: içeriği (toolData, name vb.) düzenler
                      //    ama PAYLAŞIM AYARLARINA dokunamaz. Eskiden bu dal
                      //    tamamen serbestti: listedeki herkes projeyi herkese
                      //    açık yapabiliyor, sharedWith'i baştan yazıp diğer
                      //    katılımcıları atabiliyordu.
                      //    Tek istisna: kendini listeden çıkarıp ayrılabilir
                      //    (bkz. deleteProject -> arrayRemove).
                      //    Not: isPublic'i AYNI değerle yazmak serbesttir, bu
                      //    yüzden zaten açık bir projede Paylaş düğmesi çalışır.
                      (
                        request.auth.uid in resource.data.get('sharedWith', [])
                        && request.resource.data.get('isPublic', false) == resource.data.get('isPublic', false)
                        && (
                          request.resource.data.get('sharedWith', []) == resource.data.get('sharedWith', [])
                          || request.resource.data.get('sharedWith', []) == resource.data.get('sharedWith', []).removeAll([request.auth.uid])
                        )
                        // Katılanlar listesinde herkes yalnızca kendi satırına
                        // dokunabilir: adını güncelleyebilir, ayrılırken satırını
                        // silebilir. Başkasınınkini ne değiştirebilir, ne de
                        // sahibin çıkardığı birini geri ekleyebilir.
                        && kendiSatiri()
                      )
                      ||
                      // 3) Herkese açık projeye katılma: SADECE sharedWith ve
                      //    katılanlar listesindeki kendi satırı; ikisinde de
                      //    yalnızca isteği yapanın kendi UID'si.
                      (
                        resource.data.get('isPublic', false) == true &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedWith', 'members']) &&
                        request.resource.data.sharedWith == resource.data.get('sharedWith', []).concat([request.auth.uid]) &&
                        kendiSatiri()
                      )
                    );
      
      // DELETE: Sadece projenin orijinal sahibi projeyi silebilir.
      allow delete: if request.auth != null
                    && resource.data.get('userId', '') == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // ÇALIŞMALAR
    //
    // Bir projenin 14 aracındaki bütün veri tek bir 'projects' kaydında
    // duruyordu. Veritabanı bir kaydı ya tamamen verir ya hiç vermez; bu
    // yüzden "sadece şu zihin haritasını paylaş" imkânsızdı, tek bir kanvası
    // gösterirken bütün proje karşı tarafa açılıyordu. Ayrıca kayıt 1 MB
    // sınırına doğru şişiyordu.
    //
    // Artık her çalışma (bir kırılım ağacı, bir zihin haritası, bir SWOT
    // analizi) kendi kaydında duruyor:
    //   ownerId     klasörün sahibi. Çalışmanın sahibi ayrı olmuyor: bir
    //               klasörün içindekiler klasörün sahibinindir.
    //   projectId   hangi klasörde
    //   projectName klasörün adı, kopya olarak. Karşı tarafa paylaşılan
    //               çalışmayı KENDİ klasör yolunda göstermek gerekiyor
    //               (Klasör > Araç > Çalışma). Adı burada tutmasak, o kişiye
    //               klasör kaydını okutmak zorunda kalırdık; o zaman da
    //               klasörün paylaşılmamış ayarları ve üyeleri görünürdü.
    //               Klasör adı değişince sahibi kendi çalışmalarını da
    //               günceller.
    //   tool        hangi araç (menünün orta katı)
    //   readers     bu çalışmayı görebilenlerin TAMAMI: hem tek tek bu
    //               çalışmaya davet edilenler hem de bütün klasörü
    //               paylaştığın kişiler. Tek dizi olması şart: Firestore bir
    //               sorguda yalnızca bir "dizide var mı" koşuluna izin
    //               veriyor, iki ayrı liste olsa kullanıcının görebildiği
    //               çalışmalar tek sorguda çekilemezdi.
    //   sharedWith  bunlardan yalnızca bu çalışmaya özel davet edilenler.
    //               Kimin nereden geldiğini ayırt etmek için: klasör
    //               paylaşımı kapatıldığında readers'tan kimin düşeceği
    //               buradan biliniyor.
    // ------------------------------------------------------------------
    match /works/{workId} {

      function klasor() {
        return get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data;
      }

      function kendiSatiriCalisma() {
        return request.resource.data.get('members', {})
                 .diff(resource.data.get('members', {}))
                 .affectedKeys()
                 .hasOnly([request.auth.uid]);
      }

      // CREATE: çalışmayı ancak klasörün sahibi ya da klasöre davet edilmiş
      // biri açabilir; her iki durumda da çalışma klasörün sahibine yazılır.
      //
      // readers, klasörün paylaşım listesinin aynısı olmak zorunda. Serbest
      // bıraksaydık herkes, içine başkasının kimliğini yazdığı bir çalışma
      // oluşturup o kişinin ağacında görünebilirdi (projelerde kapattığımız
      // kapının aynısı). Bu koşul aynı zamanda klasör paylaşımının sonradan
      // eklenen çalışmaları da kapsamasını sağlıyor.
      // hasAll önce geliyor: kurallar && işlemini soldan kısa devre yapıyor.
      // Eksik alanlı bir yazmada klasor() geçersiz bir yola bakar ve
      // değerlendirme hatası verir. Sonuç yine ret olurdu ama hata,
      // günlükleri gerçek bir sorun varmış gibi kirletiyor.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['ownerId', 'projectId', 'tool'])
                    && request.resource.data.ownerId == klasor().get('userId', '')
                    && (
                      klasor().get('userId', '') == request.auth.uid
                      || request.auth.uid in klasor().get('sharedWith', [])
                    )
                    && request.resource.data.get('sharedWith', []).size() == 0
                    && request.resource.data.get('members', {}).keys().size() == 0
                    && request.resource.data.get('readers', []) == klasor().get('sharedWith', []);

      // READ: sahibi, erişimi olanlar, ya da çalışmanın kendi linki açıksa
      // linki bilen herkes. Klasörün diğer çalışmaları bu kişiye kapalı
      // kalır; erişim çalışma başına veriliyor.
      // yonetici(): araç dağılımı ve son hareket listesi için gerekiyor.
      // Yalnızca okuma. Ekran bu kayıtlardan yalnızca tool, projectName ve
      // updatedAt alanlarını gösteriyor; çalışmanın içeriğine bakmıyor.
      allow read: if request.auth != null
                  && (
                    resource.data.get('ownerId', '') == request.auth.uid
                    || request.auth.uid in resource.data.get('readers', [])
                    || resource.data.get('isPublic', false) == true
                    || yonetici()
                  );

      allow update: if request.auth != null
                    && request.resource.data.get('ownerId', '') == resource.data.get('ownerId', '')
                    && request.resource.data.get('projectId', '') == resource.data.get('projectId', '')
                    && (
                      // 1) Sahip: her şeyi değiştirebilir.
                      resource.data.get('ownerId', '') == request.auth.uid
                      ||
                      // 2) Erişimi olan: içeriği düzenler, paylaşım
                      //    ayarlarına dokunamaz. Kendini listeden çıkarıp
                      //    ayrılabilir.
                      (
                        request.auth.uid in resource.data.get('readers', [])
                        && request.resource.data.get('isPublic', false) == resource.data.get('isPublic', false)
                        && (
                          request.resource.data.get('readers', []) == resource.data.get('readers', [])
                          || request.resource.data.get('readers', []) == resource.data.get('readers', []).removeAll([request.auth.uid])
                        )
                        && (
                          request.resource.data.get('sharedWith', []) == resource.data.get('sharedWith', [])
                          || request.resource.data.get('sharedWith', []) == resource.data.get('sharedWith', []).removeAll([request.auth.uid])
                        )
                        && kendiSatiriCalisma()
                      )
                      ||
                      // 3) Açık linkle katılma: yalnızca erişim listelerine ve
                      //    yalnızca isteği yapanın kendi kimliğiyle.
                      (
                        resource.data.get('isPublic', false) == true &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readers', 'sharedWith', 'members']) &&
                        request.resource.data.readers == resource.data.get('readers', []).concat([request.auth.uid]) &&
                        request.resource.data.sharedWith == resource.data.get('sharedWith', []).concat([request.auth.uid]) &&
                        kendiSatiriCalisma()
                      )
                      ||
                      // 4) Klasöre davet edilen kişi kendini çalışmanın
                      //    görebilenler listesine ekler.
                      //
                      //    Bu liste kayıt kurulurken klasörden kopyalanıyor ve
                      //    tek başına eskiyor. Tazelemeyi klasörün sahibi
                      //    yapıyor; o çevrimdışıyken klasöre katılan biri,
                      //    sahibi gelene kadar hiçbir çalışmayı ne okuyabilir
                      //    ne de yazabilirdi. Düzenlemesi eski yere gidip
                      //    kaybolurdu. Artık erişimini kendisi alıyor.
                      //
                      //    Klasörün paylaşım listesine bakılıyor, yani izin
                      //    sahibin kararından geliyor; kişi kendi kendine
                      //    yetki üretemiyor. sharedWith'e dokunulmuyor: orası
                      //    "bu çalışmaya tek tek davet edilenler" demek ve
                      //    klasörden gelen erişim oraya yazılmamalı, yoksa
                      //    klasörden çıkarılan kişi çalışmada kalırdı.
                      //    En sonda duruyor: kurallar || işlemini soldan kısa
                      //    devre yapıyor, sıradan yazmalar bu get()'in
                      //    bedelini ödemesin.
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readers']) &&
                        request.resource.data.readers == resource.data.get('readers', []).concat([request.auth.uid]) &&
                        request.auth.uid in get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.get('sharedWith', [])
                      )
                    );

      // DELETE: yalnızca sahibi. Erişimi olan biri ayrılmak isterse kendini
      // listeden çıkarır (bkz. 2. dal), çalışmayı silemez.
      allow delete: if request.auth != null
                    && resource.data.get('ownerId', '') == request.auth.uid;
    }
  }
}
